{
  "name": "formcheck-js",
  "version": "1.0.0",
  "description": "A powerful, lightweight form validation library for React, Node.js, and vanilla JavaScript. Validate emails, passwords, phone numbers, URLs, and more with zero dependencies.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/validators.test.js",
    "prepublishOnly": "npm run build && npm test",
    "lint": "echo 'No linter configured'"
  },
  "keywords": [
    "form",
    "validation",
    "validator",
    "formcheck",
    "email-validation",
    "password-validation",
    "phone-validation",
    "input-validation",
    "react",
    "nodejs",
    "form-validation",
    "schema-validation",
    "javascript",
    "lightweight"
  ],
  "author": {
    "name": "Raj Kumar",
    "email": "raj@gmail.com",
    "url": "https://github.com/Raj9975126"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Raj9975126/NPM-From_check-Package.git"
  },
  "homepage": "https://github.com/Raj9975126/NPM-From_check-Package#readme",
  "bugs": {
    "url": "https://github.com/Raj9975126/NPM-From_check-Package/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {}
}
